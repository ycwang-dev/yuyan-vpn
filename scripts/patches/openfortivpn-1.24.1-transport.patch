diff --git a/src/tunnel.c b/src/tunnel.c
index 48ec196..a56e875 100644
--- a/src/tunnel.c
+++ b/src/tunnel.c
@@ -77,6 +77,50 @@ struct ofv_varr {
 	const char **data;	// NULL terminated
 };
 
+#define YUYAN_TCP_KEEPALIVE_IDLE_SECONDS 30
+#define YUYAN_TCP_KEEPALIVE_INTERVAL_SECONDS 10
+#define YUYAN_TCP_KEEPALIVE_PROBES 4
+
+/** 启用内核 TCP 保活，降低 NAT、TUN 重载和短时断网造成的半开连接风险。 */
+static void configure_tcp_keepalive(int handle)
+{
+	const int enabled = 1;
+	const int idle = YUYAN_TCP_KEEPALIVE_IDLE_SECONDS;
+	const int interval = YUYAN_TCP_KEEPALIVE_INTERVAL_SECONDS;
+	const int probes = YUYAN_TCP_KEEPALIVE_PROBES;
+
+	if (setsockopt(handle, SOL_SOCKET, SO_KEEPALIVE,
+	               (const char *) &enabled, sizeof(enabled))) {
+		log_warn("setsockopt SO_KEEPALIVE: %s\n", strerror(errno));
+		return;
+	}
+
+#if defined(TCP_KEEPALIVE)
+	if (setsockopt(handle, IPPROTO_TCP, TCP_KEEPALIVE,
+	               (const char *) &idle, sizeof(idle)))
+		log_warn("setsockopt TCP_KEEPALIVE: %s\n", strerror(errno));
+#elif defined(TCP_KEEPIDLE)
+	if (setsockopt(handle, IPPROTO_TCP, TCP_KEEPIDLE,
+	               (const char *) &idle, sizeof(idle)))
+		log_warn("setsockopt TCP_KEEPIDLE: %s\n", strerror(errno));
+#endif
+
+#if defined(TCP_KEEPINTVL)
+	if (setsockopt(handle, IPPROTO_TCP, TCP_KEEPINTVL,
+	               (const char *) &interval, sizeof(interval)))
+		log_warn("setsockopt TCP_KEEPINTVL: %s\n", strerror(errno));
+#endif
+
+#if defined(TCP_KEEPCNT)
+	if (setsockopt(handle, IPPROTO_TCP, TCP_KEEPCNT,
+	               (const char *) &probes, sizeof(probes)))
+		log_warn("setsockopt TCP_KEEPCNT: %s\n", strerror(errno));
+#endif
+
+	log_info("TCP keepalive enabled: idle=%ds, interval=%ds, probes=%d.\n",
+	         idle, interval, probes);
+}
