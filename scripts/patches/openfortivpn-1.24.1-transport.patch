+/** 记录 TLS 传输结束原因，并保留 OpenSSL 错误队列用于定位服务端主动断开。 */
+static void log_tls_transport_end(const char *operation, int error,
+                                  unsigned int lcp_echo_replies)
+{
+	unsigned long tls_error = ERR_peek_last_error();
+
+	if (error == ERR_TLS_SEE_ERRNO) {
+		log_warn("TLS transport ended while %s: %s (errno=%d); LCP echo replies=%u.\n",
+		         operation, err_ssl_str(error), errno, lcp_echo_replies);
+	} else if ((error == ERR_TLS_PROTOCOL || error == ERR_TLS_SEE_TLSERR)
+	           && tls_error != 0) {
+		char error_buffer[256];
+
+		ERR_error_string_n(tls_error, error_buffer, sizeof(error_buffer));
+		log_warn("TLS transport ended while %s: %s; OpenSSL=%s; LCP echo replies=%u.\n",
+		         operation, err_ssl_str(error), error_buffer,
+		         lcp_echo_replies);
+	} else {
+		log_warn("TLS transport ended while %s: %s; LCP echo replies=%u.\n",
+		         operation, err_ssl_str(error), lcp_echo_replies);
+	}
+}
