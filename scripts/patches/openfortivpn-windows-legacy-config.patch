diff --git a/src/http.c b/src/http.c
--- a/src/http.c
+++ b/src/http.c
@@ -957,6 +957,54 @@ static int parse_xml_config(struct tunnel *tunnel, const char *buffer)
 	return 1;
 }
 
+/* FortiOS 4/5 portals can omit fortisslvpn_xml and expose split routes in text6. */
+static int parse_legacy_config(struct tunnel *tunnel, const char *buffer)
+{
+	const char *c, *end;
+
+	buffer = strcasestr(buffer, "NAME=\"text6\"");
+	if (!buffer)
+		return 1;
+	buffer = strcasestr(buffer, "VALUE=\"");
+	if (!buffer)
+		return 1;
+	buffer += 7;
+
+	end = strchr(buffer, '"');
+	if (end == NULL || end == buffer) {
+		log_info("No split VPN route in legacy configuration\n");
+		return 1;
+	}
+
+	do {
+		char dest[16], mask[16];
+
+		c = strchr(buffer, '/');
+		if (c == NULL || c >= end || c - buffer > 15) {
+			log_warn("Wrong addresses in split VPN route: expected <dest>/<mask>\n");
+			return 1;
+		}
+		memcpy(dest, buffer, c - buffer);
+		dest[c - buffer] = '\0';
+		buffer = c + 1;
+
+		c = strchr(buffer, ',');
+		if (c == NULL || c > end)
+			c = end;
+		if (c - buffer > 15) {
+			log_warn("Wrong addresses in split VPN route: expected <dest>/<mask>\n");
+			return 1;
+		}
+		memcpy(mask, buffer, c - buffer);
+		mask[c - buffer] = '\0';
+		buffer = c + 1;
+
+		ipv4_add_split_vpn_route(tunnel, dest, mask, NULL);
+	} while (c < end && *c == ',');
+
+	return 1;
+}
+
 
 int auth_get_config(struct tunnel *tunnel)
 {
@@ -968,5 +1016,17 @@ int auth_get_config(struct tunnel *tunnel)
 		free(buffer);
 	}
 
+	if (ret != 1) {
+		log_warn("XML VPN configuration unavailable (HTTP status %d); retrying legacy FortiOS configuration endpoint.\n",
+		         ret);
+		ret = http_request(tunnel, "GET", "/remote/fortisslvpn", "", &buffer, NULL);
+		if (ret == 1) {
+			ret = parse_legacy_config(tunnel, buffer);
+			free(buffer);
+			if (ret == 1)
+				log_info("Legacy FortiOS VPN configuration accepted.\n");
+		}
+	}
+
 	return ret;
 }
