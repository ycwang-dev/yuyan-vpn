+/*
+ * Test: Build a client-initiated LCP Echo-Request for tunnel keepalive.
+ */
+static void test_build_lcp_echo_request(void)
+{
+	uint8_t *request;
+	size_t request_len;
+	int ret;
+
+	TEST("build client LCP Echo-Request");
+	ret = ppp_build_echo_request(0x2a, 0x12345678,
+	                             &request, &request_len);
+	ASSERT(ret == 0, "should return 0");
+	ASSERT(request_len == 10, "echo request should contain 10 bytes");
+	ASSERT(request[0] == 0xc0 && request[1] == 0x21,
+	       "protocol should be LCP");
+	ASSERT(request[2] == PPP_CODE_ECHO_REQ,
+	       "code should be Echo-Request");
+	ASSERT(request[3] == 0x2a, "identifier should match");
+	ASSERT(request[6] == 0x12 && request[7] == 0x34 &&
+	       request[8] == 0x56 && request[9] == 0x78,
+	       "magic number should be encoded in network order");
+
+	free(request);
+	PASS();
+}
