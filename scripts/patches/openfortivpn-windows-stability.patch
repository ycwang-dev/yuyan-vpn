+/*
+ * Send an RFC 1661 LCP Echo-Request periodically after IPCP is ready.
+ * This keeps NAT mappings and legacy FortiGate sessions active even when
+ * user traffic is idle. Echo replies continue to be handled by ssl_read.
+ */
+static void *keepalive_thread(void *arg)
+{
+	struct tunnel *tunnel = (struct tunnel *)arg;
+	struct ppp_context *ppp_ctx =
+	        (struct ppp_context *)tunnel->ppp_ctx;
+
+	log_debug("%s thread\n", __func__);
+	while (!InterlockedCompareExchange(&shutting_down, 0, 0)) {
+		int elapsed;
+
+		for (elapsed = 0; elapsed < LCP_ECHO_INTERVAL_SECONDS; elapsed++) {
+			if (InterlockedCompareExchange(&shutting_down, 0, 0))
+				return NULL;
+			Sleep(1000);
+		}
+		if (tunnel->state == STATE_UP) {
+			uint8_t *echo_data;
+			size_t echo_len;
+			uint8_t id = (uint8_t)InterlockedIncrement(&echo_identifier);
+
+			if (ppp_build_echo_request(id, ppp_ctx->magic_number,
+			                           &echo_data, &echo_len) == 0) {
+				struct ppp_packet *packet =
+				        malloc(sizeof(*packet) + 6 + echo_len);
+
+				if (packet) {
+					packet->len = echo_len;
+					memcpy(pkt_data(packet), echo_data, echo_len);
+					pool_push(&tunnel->pty_to_ssl_pool, packet);
+					log_debug("Sent LCP Echo-Request keepalive.\n");
+				}
+				free(echo_data);
+			}
+		}
+	}
 	return NULL;
 }
 
