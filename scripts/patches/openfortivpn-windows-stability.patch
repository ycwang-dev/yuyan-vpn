diff --git a/src/ppp.c b/src/ppp.c
index 3184cff..9d72337 100644
--- a/src/ppp.c
+++ b/src/ppp.c
@@ -84,6 +84,20 @@ static int build_echo_reply(uint8_t id, uint32_t magic,
 	return 0;
 }
 
+int ppp_build_echo_request(uint8_t id, uint32_t magic,
+                           uint8_t **out_data, size_t *out_len)
+{
+	uint8_t magic_bytes[4];
+
+	magic_bytes[0] = (uint8_t)(magic >> 24);
+	magic_bytes[1] = (uint8_t)(magic >> 16);
+	magic_bytes[2] = (uint8_t)(magic >> 8);
+	magic_bytes[3] = (uint8_t)magic;
+	return build_control_packet(PPP_PROTO_LCP, PPP_CODE_ECHO_REQ, id,
+	                            magic_bytes, sizeof(magic_bytes),
+	                            out_data, out_len);
+}
+
 void ppp_init(struct ppp_context *ctx)
 {
 	memset(ctx, 0, sizeof(*ctx));
