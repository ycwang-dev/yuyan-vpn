+func negotiateQuickSocks5(conn net.Conn, reader *bufio.Reader) error {
+	if err := conn.SetReadDeadline(time.Now().Add(5 * time.Second)); err != nil {
+		return err
+	}
+	defer conn.SetReadDeadline(time.Time{})
+
+	header := make([]byte, 2)
+	if _, err := io.ReadFull(reader, header); err != nil {
+		return fmt.Errorf("read quick SOCKS5 greeting: %w", err)
+	}
+	if header[0] == 0x05 && header[1] == 0x81 {
+		if _, err := io.ReadFull(reader, header); err != nil {
+			return fmt.Errorf("read quick SOCKS5 protocol header: %w", err)
+		}
+	}
+	if header[0] != 0x53 || header[1] != 0x00 {
+		return fmt.Errorf("unexpected quick SOCKS5 protocol header: %02X %02X", header[0], header[1])
+	}
+
+	lengthBytes := make([]byte, 2)
+	if _, err := io.ReadFull(reader, lengthBytes); err != nil {
+		return fmt.Errorf("read quick SOCKS5 protocol length: %w", err)
+	}
+	length := binary.BigEndian.Uint16(lengthBytes)
+	response := make([]byte, length)
+	if _, err := io.ReadFull(reader, response); err != nil {
+		return fmt.Errorf("read quick SOCKS5 protocol response: %w", err)
+	}
+	if !strings.Contains(string(response), `"message":"OK"`) {
+		return fmt.Errorf("quick SOCKS5 initialization rejected: %s", string(response))
+	}
+
+	socksReply := make([]byte, 10)
+	if _, err := io.ReadFull(reader, socksReply); err != nil {
+		return fmt.Errorf("read quick SOCKS5 destination response: %w", err)
+	}
+	if socksReply[0] != 0x05 || socksReply[1] != 0x00 {
+		return fmt.Errorf("quick SOCKS5 destination rejected: %02X %02X", socksReply[0], socksReply[1])
+	}
+	log.Println("aTrust TCP tunnel: Quick SOCKS5 negotiation completed")
+	return nil
+}
